<!doctype html>
<html>
<head>
  <meta charset="utf-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover"
  >

  <meta
    name="apple-mobile-web-app-capable"
    content="yes"
  >

  <meta
    name="apple-mobile-web-app-title"
    content="School"
  >

  <meta
    name="apple-mobile-web-app-status-bar-style"
    content="default"
  >

  <meta
    name="mobile-web-app-capable"
    content="yes"
  >

  <meta
    name="theme-color"
    content="#5b67d6"
  >

  <meta
    http-equiv="refresh"
    content="300"
  >

  <link
    rel="apple-touch-icon"
    href="/school-icon.svg"
  >

  <link
    rel="icon"
    href="/school-icon.svg"
  >

  <link
    rel="manifest"
    href="/manifest.json"
  >

  <link
    rel="stylesheet"
    href="/dashboard.css?v=<%= File.mtime(File.join(APP_ROOT, "public", "dashboard.css")).to_i %>"
  >

  <title>School Dashboard</title>
</head>

<body>
  <main class="container">

    <%
      course_name_mappings =
        begin
          mappings_file =
            if File.directory?("/data")
              "/data/course_name_mappings.json"
            else
              File.join(APP_ROOT, "tmp", "course_name_mappings.json")
            end

          JSON.parse(
            File.read(mappings_file)
          )
        rescue Errno::ENOENT, JSON::ParserError
          {}
        end

      display_course_name = lambda do |course_id|
        canvas_name = course_name(data, course_id).to_s.strip
        course_name_mappings.fetch(course_id.to_s, canvas_name)
      end

      grade_overrides = load_grade_overrides
      valid_grades = combined_grade_submissions(data, grade_overrides)
      grades_by_course = valid_grades.group_by do |submission|
        submission.dig("assignment", "course_id").to_s
      end

      grade_snapshot = grades_by_course.filter_map do |course_id, submissions|
        earned = submissions.sum { |submission| submission["score"].to_f }
        possible = submissions.sum do |submission|
          submission.dig("assignment", "points_possible").to_f
        end
        calculated = percentage(earned, possible)
        next unless calculated

        course_display_name = display_course_name.call(course_id)

        {
          "course_id" => course_id,
          "name" => course_display_name,
          "symbol" => course_symbol(course_display_name),
          "percentage" => calculated.round,
          "letter" => letter_grade(calculated)
        }
      end.sort_by { |grade| grade["name"] }

      now = Time.now
      today = now.getlocal.to_date
      tomorrow = today + 1
      end_time = now + (7 * 24 * 60 * 60)

      missing = (data["missing"] || []).sort_by do |assignment|
        assignment_due_time(assignment) || Time.at(0)
      end

      upcoming = (data["upcoming"] || []).select do |event|
        due = assignment_due_time(event)
        due && due >= now && due <= end_time
      end.sort_by do |event|
        assignment_due_time(event)
      end

      upcoming_by_date = upcoming.group_by do |event|
        assignment_due_time(event).getlocal.to_date
      end

      incomplete_upcoming = upcoming.reject do |event|
        submission_complete?(
          submission_for(
            data,
            assignment_course_id(event),
            assignment_id(event)
          )
        )
      end

      due_today = incomplete_upcoming.count do |event|
        assignment_due_time(event).getlocal.to_date == today
      end

      due_tomorrow = incomplete_upcoming.count do |event|
        assignment_due_time(event).getlocal.to_date == tomorrow
      end

      todo = (data["todo"] || []).sort_by do |item|
        assignment_due_time(item) || Time.at(Float::INFINITY)
      end

      token_days = token_days_remaining
      token_expiration_date = token_expiration
    %>

    <!-- =====================================================
         Header
         ===================================================== -->

    <header class="top-header">
      <div class="header-copy">
        <h1>
          <%= h greeting_for(now) %>,
          <%= h profile_first_name(data) %>!
        </h1>

        <div class="subtitle"><%= now.strftime("%A, %B %-d") %></div>
      </div>

      <div class="header-date-mark" aria-hidden="true">
        <span><%= now.strftime("%b") %></span>
        <strong><%= now.strftime("%-d") %></strong>
      </div>
    </header>

    <% unless grade_snapshot.empty? %>
      <section class="grade-snapshot" aria-label="Overall grade snapshot">
        <div class="grade-snapshot-label">Grade snapshot</div>

        <div class="grade-snapshot-list">
          <% grade_snapshot.each do |grade| %>
            <a
              class="grade-snapshot-item grade-<%= grade["letter"].downcase %><%= " perfect-grade" if grade["percentage"] >= 100 %>"
              href="#grade-course-<%= h grade["course_id"] %>"
              title="<%= h grade["name"] %>"
            >
              <span class="grade-snapshot-symbol" aria-hidden="true">
                <%= grade["symbol"] %>
              </span>
              <span class="sr-only"><%= h grade["name"] %>:</span>
              <strong><%= grade["percentage"] %>%</strong>
              <span class="grade-snapshot-letter"><%= grade["letter"] %></span>
            </a>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if token_days && token_days <= 7 %>
      <div class="token-expiration-alert" role="alert">
        <div>
          <strong>
            <% if token_days < 0 %>
              Canvas token expired <%= token_days.abs %> days ago.
            <% elsif token_days == 0 %>
              Canvas token expires today.
            <% else %>
              Canvas token expires in <%= token_days %> days.
            <% end %>
          </strong>
          Refresh the access token to keep dashboard updates working.
        </div>

        <a
          href="<%= h "#{BASE_URL}/profile/settings" %>"
          target="_blank"
          rel="noopener noreferrer"
        >
          Open Canvas Settings
        </a>
      </div>
    <% end %>

    <section class="today-summary">
      <div>
        <h2>Up next</h2>

        <p>
          <% if due_today.zero? && due_tomorrow.zero? && missing.empty? %>
            All clear 🎉
          <% else %>
            <span class="up-next-items">
              <% if due_today > 0 %>
                <span>
                  <%= due_today %>
                  <%= due_today == 1 ? "assignment" : "assignments" %>
                  left today
                </span>
              <% end %>

              <% if due_tomorrow > 0 %>
                <span><%= due_tomorrow %> due tomorrow</span>
              <% end %>

              <% unless missing.empty? %>
                <strong><%= missing.length %> missing</strong>
              <% end %>
            </span>
          <% end %>
        </p>
      </div>

      <form class="refresh-form" method="post" action="/refresh">
        <button class="refresh-button" type="submit">
          <span class="refresh-button-label">↻ Refresh Canvas</span>
          <span class="refresh-button-progress" aria-hidden="true">
            <span class="refresh-spinner"></span>
            Refreshing…
          </span>
        </button>
      </form>
    </section>

    <!-- =====================================================
         Canvas Status
         ===================================================== -->

    <% status = dashboard_status %>

    <% if status[:error] %>

      <div class="system-status warning">
        <strong>
          ⚠ Canvas is temporarily unavailable.
        </strong>

        Showing saved data from

        <% if status[:updated_at] %>
          <%= status[:updated_at].strftime("%-I:%M %p") %>.
        <% else %>
          the last update.
        <% end %>
      </div>

    <% end %>

    <!-- =====================================================
         Missing Assignments
         ===================================================== -->

    <% unless missing.empty? %>

      <section class="missing-section">

        <div class="missing-heading">

          <div>
            <div class="eyebrow danger-text">
              NEEDS ATTENTION
            </div>

            <h2>
              ⚠️ Missing Assignments
            </h2>
          </div>

          <div class="missing-count">
            <%= missing.length %>
          </div>

        </div>

        <% missing.each do |assignment| %>

          <%
            course_id = assignment_course_id(assignment)
            due = assignment_due_time(assignment)
            url = assignment_url(assignment)
          %>

          <div class="missing-row">

            <div class="missing-icon">
              !
            </div>

            <div class="assignment-main">

              <div class="assignment-title">

                <% if url %>
                  <a
                    href="<%= h url %>"
                    target="_blank"
                  >
                    <%= h assignment_name(assignment) %>
                  </a>
                <% else %>
                  <%= h assignment_name(assignment) %>
                <% end %>

              </div>

              <div class="assignment-course">
                <%= h display_course_name.call(course_id) %>
              </div>

            </div>

            <div class="assignment-due overdue">

              <strong>
                <%= due ? date_label(due) : "Missing" %>
              </strong>

              <% if due %>
                <span>
                  <%= h due_time_label(due) %>
                </span>
              <% end %>

            </div>

          </div>

        <% end %>

      </section>

    <% end %>

    <!-- =====================================================
         To-do List
         ===================================================== -->

    <section class="section">

      <div class="section-header">
        <h2>✅ My To-Dos</h2>

        <div class="section-note">
          <%= todo.length %> remaining
        </div>
      </div>

      <div class="card todo-card">

        <% if todo.empty? %>

          <div class="empty-state">
            <div class="empty-check">✓</div>

            <div>
              <strong>To-do list complete.</strong>
              <span>Nothing needs attention in Canvas.</span>
            </div>
          </div>

        <% else %>

          <% todo.each do |item| %>
            <%
              course_id = assignment_course_id(item)
              due = assignment_due_time(item)
              calendar_date = due ?
                "#view_name=agenda&view_start=#{due.getlocal.to_date.iso8601}" :
                ""
              url = assignment_url(item) ||
                "#{BASE_URL}/calendar#{calendar_date}"
            %>

            <div class="todo-row">
              <form
                class="todo-complete-form"
                method="post"
                action="/todo/complete"
              >
                <input
                  type="hidden"
                  name="id"
                  value="<%= h item["plannable_id"] %>"
                >

                <button
                  class="todo-checkbox"
                  type="submit"
                  title="Mark complete"
                  aria-label="Mark <%= h assignment_name(item) %> complete"
                >
                  ✓
                </button>
              </form>

              <div class="assignment-main">
                <div class="assignment-title">
                  <a
                    href="<%= h url %>"
                    target="_blank"
                    rel="noopener noreferrer"
                    title="Open in Canvas"
                  >
                    <%= h assignment_name(item) %>
                  </a>
                </div>

                <div class="assignment-course">
                  <%= h display_course_name.call(course_id) %>
                </div>
              </div>

              <% if due %>
                <div class="assignment-due">
                  <strong><%= h date_label(due) %></strong>
                  <span><%= h due_time_label(due) %></span>
                </div>
              <% end %>

              <details class="todo-edit">
                <summary>
                  <span class="todo-edit-pencil" aria-hidden="true">✎</span>
                  <span class="todo-edit-label">
                    Edit <%= h assignment_name(item) %>
                  </span>
                  <span class="todo-edit-cancel">
                    <span aria-hidden="true">&times;</span>
                    Cancel
                  </span>
                </summary>

                <form method="post" action="/todo/update">
                  <input
                    type="hidden"
                    name="id"
                    value="<%= h item["plannable_id"] %>"
                  >

                  <label class="todo-title-field">
                    <span>To-do</span>
                    <input
                      type="text"
                      name="title"
                      maxlength="255"
                      value="<%= h assignment_name(item) %>"
                      required
                    >
                  </label>

                  <label>
                    <span>Date</span>
                    <input
                      type="date"
                      name="todo_date"
                      value="<%= due ? due.getlocal.to_date.iso8601 : today.iso8601 %>"
                      required
                    >
                  </label>

                  <label>
                    <span>Course</span>
                    <select name="course_id">
                      <option value="">Personal</option>
                      <% (data["courses"] || []).sort_by { |course| course["name"] }.each do |course| %>
                        <option
                          value="<%= h course["id"] %>"
                          <%= "selected" if course["id"].to_s == course_id.to_s %>
                        >
                          <%= h display_course_name.call(course["id"]) %>
                        </option>
                      <% end %>
                    </select>
                  </label>

                  <label class="todo-details-field">
                    <span>Details (optional)</span>
                    <textarea name="details" rows="2"><%= h(item.dig("plannable", "details") || item.dig("plannable", "description") || "") %></textarea>
                  </label>

                  <button class="todo-save-button" type="submit">
                    Save Changes
                  </button>
                </form>
              </details>
            </div>
          <% end %>

        <% end %>

        <details class="todo-create">
          <summary>
            <span class="todo-create-open">+ Add To-Do</span>
            <span class="todo-create-cancel">
              <span aria-hidden="true">&times;</span>
              Cancel
            </span>
          </summary>

          <form class="todo-create-form" method="post" action="/todo/create">
            <label class="todo-title-field">
              <span>New to-do</span>
              <input
                type="text"
                name="title"
                maxlength="255"
                placeholder="What needs to be done?"
                required
              >
            </label>

            <label>
              <span>Date</span>
              <input
                type="date"
                name="todo_date"
                value="<%= today.iso8601 %>"
                required
              >
            </label>

            <label>
              <span>Course</span>
              <select name="course_id">
                <option value="">Personal</option>
                <% (data["courses"] || []).sort_by { |course| course["name"] }.each do |course| %>
                  <option value="<%= h course["id"] %>">
                    <%= h display_course_name.call(course["id"]) %>
                  </option>
                <% end %>
              </select>
            </label>

            <label class="todo-details-field">
              <span>Details (optional)</span>
              <textarea name="details" rows="2"></textarea>
            </label>

            <button class="todo-add-button" type="submit">
              + Add To-Do
            </button>
          </form>
        </details>

      </div>

    </section>

        <!-- =====================================================
          Upcoming Assignments
          ===================================================== -->

    <section class="section">

      <div class="section-header">

        <h2>
          📅 Upcoming Assignments
        </h2>

        <div class="section-note">
          <%= upcoming.length %> upcoming
        </div>

      </div>

      <div class="card">

        <% if upcoming.empty? %>

          <div class="empty-state">

            <div class="empty-check">
              ✓
            </div>

            <div>
              <strong>
                Nothing due in the next 7 days.
              </strong>

              <span>
                You're all caught up!
              </span>
            </div>

          </div>

        <% else %>

          <% upcoming_by_date.each do |_date, events| %>

            <%
              first_due = assignment_due_time(events.first)
              events = events.sort_by do |event|
                submission = submission_for(
                  data,
                  assignment_course_id(event),
                  assignment_id(event)
                )

                [submission_complete?(submission) ? 1 : 0,
                 assignment_due_time(event)]
              end

              day_complete = events.all? do |event|
                submission_complete?(
                  submission_for(
                    data,
                    assignment_course_id(event),
                    assignment_id(event)
                  )
                )
              end
            %>

            <div class="day-group">

              <div class="day-heading">
                <%= h date_label(first_due) %>
              </div>

              <% if day_complete %>
                <div class="day-complete">
                  ✓ All done for
                  <%= h first_due.getlocal.strftime("%A") %>
                </div>
              <% end %>

              <% events.each do |event| %>

                <%
                  due = assignment_due_time(event)
                  course_id = assignment_course_id(event)
                  aid = assignment_id(event)
                  url = assignment_url(event)

                  submission = submission_for(
                    data,
                    course_id,
                    aid
                  )

                  assignment_status =
                    submission_status(submission)

                  comment = latest_submission_comment(submission)

                  row_class =
                    if submission_complete?(submission)
                      "upcoming-row completed"
                    elsif assignment_status[:css] == "not-submitted"
                      "upcoming-row needs-work"
                    else
                      "upcoming-row"
                    end
                %>

                <div class="<%= row_class %>">

                  <div
                    class="submission-icon <%= assignment_status[:css] %>"
                  >
                    <%= assignment_status[:icon] %>
                  </div>

                  <div class="assignment-main">

                    <div class="assignment-title">

                      <% if url %>
                        <a
                          href="<%= h url %>"
                          target="_blank"
                        >
                          <%= h assignment_name(event) %>
                        </a>
                      <% else %>
                        <%= h assignment_name(event) %>
                      <% end %>

                    </div>

                    <div class="assignment-course">
                      <%= h display_course_name.call(course_id) %>
                    </div>

                    <div
                      class="submission-status <%= assignment_status[:css] %>"
                    >
                      <%= h assignment_status[:label] %>
                      <% if comment %>
                        · 💬 Feedback
                      <% end %>
                    </div>

                    <% if comment %>
                      <div class="teacher-comment">
                        <strong>
                          💬 <%= h(comment["author_name"] || "Teacher") %>:
                        </strong>
                        <%= h comment["comment"] %>
                      </div>
                    <% end %>

                  </div>

                  <div class="assignment-due">
                    <%= h due_time_label(due) %>
                  </div>

                </div>

              <% end %>

            </div>

          <% end %>

        <% end %>

      </div>

    </section>

    <!-- =====================================================
         Grades
         ===================================================== -->

    <%
      grade_course_ids = (
        (data["courses"] || []).map { |course| course["id"].to_s } +
        grades_by_course.keys
      ).uniq.sort_by do |course_id|
        display_course_name.call(course_id)
      end
    %>

    <section class="section" id="grades">

      <div class="section-header">

        <h2>
          📊 Grades
        </h2>

        <div class="section-header-actions">
          <div class="section-note">
            Official grades override Canvas estimates
          </div>
          <a class="section-action-link" href="/grades">Edit Grades</a>
        </div>

      </div>

      <% grade_course_ids.each do |course_id| %>

        <%
          submissions = grades_by_course.fetch(course_id, [])

          earned = submissions.sum do |submission|
            submission["score"].to_f
          end

          possible = submissions.sum do |submission|
            submission.dig(
              "assignment",
              "points_possible"
            ).to_f
          end

          calculated = percentage(
            earned,
            possible
          )

          has_edited_grades = submissions.any? do |submission|
            submission["_official_override"]
          end

          displayed_percentage = calculated
          displayed_letter = letter_grade(displayed_percentage)

          recent = submissions.sort_by do |submission|
            submission["graded_at"] ||
              submission.dig(
                "assignment",
                "due_at"
              ) ||
              ""
          end.reverse
        %>

        <section
          class="grade-card"
          id="grade-course-<%= h course_id %>"
        >

          <div class="grade-header<%= displayed_letter&.match?(/\A[A-F]\z/) ? " grade-#{displayed_letter.downcase}" : "" %>">

            <div>

              <h3>
                <%= h display_course_name.call(course_id) %>
              </h3>

              <div class="grade-meta">
                <% if submissions.empty? %>
                  No graded Canvas assignments
                <% else %>
                  <%= has_edited_grades ? "Canvas + edited grades" : "Canvas estimate" %> ·
                  <%= submissions.length %>
                  graded <%= submissions.length == 1 ? "assignment" : "assignments" %>
                  ·
                  <%= h format_number(earned) %>
                  /
                  <%= h format_number(possible) %>
                  pts
                <% end %>
              </div>

            </div>

            <div class="grade-percent">
              <% if displayed_percentage %>
                <span class="grade-value"><%= h format_number(displayed_percentage) %>%</span>
              <% end %>
              <% if displayed_letter %>
                <span class="grade-letter"><%= h displayed_letter %></span>
              <% elsif displayed_percentage.nil? %>
                —
              <% else %>
                <span class="grade-letter"><%= h letter_grade(displayed_percentage) %></span>
              <% end %>
            </div>

          </div>

          <% unless recent.empty? %>
            <div class="recent-label">
              RECENT CANVAS GRADES
            </div>
          <% end %>

          <div class="grade-list">
            <% recent.each do |submission| %>

              <%
                assignment = submission["assignment"]

                score = submission["score"]
                points = assignment["points_possible"]

                pct = percentage(
                  score,
                  points
                )

                url = assignment["html_url"]
                official_override = submission["_official_override"]

                grade_class =
                  if pct && pct < 70
                    " low-grade"
                  elsif pct && pct < 80
                    " warning-grade"
                  else
                    ""
                  end
              %>

              <div class="grade-row<%= grade_class %>">

                <div class="assignment-main">

                  <div class="assignment-title">

                    <% if url %>
                      <a
                        href="<%= h url %>"
                        target="_blank"
                      >
                        <%= h assignment["name"] %>
                      </a>
                    <% else %>
                      <%= h assignment["name"] %>
                    <% end %>

                  </div>

                  <div class="assignment-course">
                    <%= h grade_date(
                      submission["graded_at"] ||
                      assignment["due_at"]
                    ) %>
                    <% if official_override %>
                      <span class="official-grade-badge">Edited</span>
                    <% end %>
                  </div>

                </div>

                <div class="grade-score">

                  <strong>
                    <%= h format_number(score) %>
                    /
                    <%= h format_number(points) %>
                  </strong>

                  <% if pct %>
                    <span<%= pct == 100 ? ' class="perfect-score" title="Perfect score!"' : "" %>>
                      <%= pct %>%
                    </span>
                  <% end %>

                  <% if official_override && !submission["_custom_grade"] %>
                    <span class="canvas-grade-original">
                      Canvas:
                      <%= h format_number(submission["_canvas_score"]) %>/<%= h format_number(submission["_canvas_points_possible"]) %>
                    </span>
                  <% end %>

                </div>

              </div>

            <% end %>
          </div>

          <% if recent.length > 5 %>
            <button
              class="grade-more-button"
              type="button"
              hidden
            >
              See more
            </button>
          <% end %>

        </section>

      <% end %>

    </section>

    <footer class="site-footer">
      <% if status[:updated_at] %>
        <div class="canvas-update-footer">
          <span aria-hidden="true"></span>
          Canvas updated <%= status[:updated_at].strftime("%-I:%M %p") %>
        </div>
      <% end %>

      <% if token_days %>
        <div class="token-footer">
          🔑 Canvas token:
          <% if token_days < 0 %>
            expired <%= token_days.abs %> days ago
          <% else %>
            <%= token_days %> days remaining
          <% end %>

          <% if token_expiration_date %>
            <span>
              Expires <%= token_expiration_date.strftime("%b %-d, %Y") %>
            </span>
          <% end %>
        </div>
      <% end %>

      <a class="class-names-link" href="/class-names">
        Edit Class Names
      </a>
      <a class="class-names-link" href="/grades">
        Edit Assignment Grades
      </a>
    </footer>

  </main>

  <script>
    document.querySelector(".refresh-form").addEventListener("submit", (event) => {
      const button = event.currentTarget.querySelector(".refresh-button");

      button.classList.add("is-refreshing");
      button.disabled = true;
      button.setAttribute("aria-label", "Refreshing Canvas");
    });

    document.querySelectorAll(".todo-complete-form").forEach((form) => {
      form.addEventListener("submit", () => {
        const row = form.closest(".todo-row");
        const button = form.querySelector(".todo-checkbox");

        row.classList.add("is-completing");
        button.disabled = true;
        button.setAttribute("aria-label", "Marking to-do complete");
      });
    });

    document.querySelectorAll(".grade-card").forEach((card) => {
      const rows = Array.from(
        card.querySelectorAll(".grade-list > .grade-row")
      );
      const button = card.querySelector(".grade-more-button");

      if (!button || rows.length <= 5) return;

      let visibleCount = 5;
      rows.slice(visibleCount).forEach((row) => {
        row.hidden = true;
      });
      button.hidden = false;

      button.addEventListener("click", () => {
        const nextCount = Math.min(visibleCount + 5, rows.length);

        rows.slice(visibleCount, nextCount).forEach((row) => {
          row.hidden = false;
        });

        visibleCount = nextCount;
        button.hidden = visibleCount >= rows.length;
      });
    });
  </script>
</body>
</html>
