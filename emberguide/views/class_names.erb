<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover"
  >
  <meta name="theme-color" content="#080711">
  <link
    rel="stylesheet"
    href="/dashboard.css?v=<%= File.mtime(File.join(APP_ROOT, "public", "dashboard.css")).to_i %>"
  >
  <title>Classes</title>
</head>

<body>
  <main class="container settings-page">
    <%
      navigation_active = "settings"
    %>
    <%= render_partial("navigation", binding) %>

    <header class="settings-header">
      <div>
        <h1>Classes</h1>
        <div class="subtitle">
          Rename or hide Canvas classes, and manage classes added in EmberGuide.
        </div>
      </div>

    </header>

    <form class="card class-name-settings" method="post" action="/settings/classes">
      <h2>Canvas Classes</h2>
      <p class="settings-intro">
        Choose a shorter display name or hide a class from the dashboard.
      </p>

      <% (data["courses"] || []).reject { |course| course["_manual"] }.sort_by { |course| course["name"].to_s.strip }.each do |course| %>
        <div class="class-name-row">
          <span class="canvas-class-name">
            <%= h course["name"].to_s.strip %>
          </span>
          <span class="short-name-label">Short name</span>
          <input
            type="text"
            name="course_<%= h course["id"] %>"
            value="<%= h mappings[course["id"].to_s] %>"
            maxlength="80"
            placeholder="Use Canvas name"
          >

          <label class="hide-class-field">
            <input
              type="checkbox"
              name="hidden_course_<%= h course["id"] %>"
              value="true"
              <%= "checked" if hidden_course_ids.include?(course["id"].to_s) %>
            >
            <span>Hide from dashboard</span>
          </label>
        </div>
      <% end %>

      <div class="settings-actions">
        <a href="/">Cancel</a>
        <button type="submit">Save Class Settings</button>
      </div>
    </form>

    <section class="card coursework-settings-section">
      <h2>Classes Outside Canvas</h2>
      <p class="settings-intro">
        Add classes that should appear in EmberGuide but are not available in Canvas.
      </p>

      <div class="coursework-list">
        <% coursework["courses"].sort_by { |_id, course| course["name"] }.each do |id, course| %>
          <form class="coursework-row" method="post" action="/settings/classes">
            <input type="hidden" name="action" value="update_course">
            <input type="hidden" name="id" value="<%= h id %>">

            <label class="coursework-name-field">
              <span>Class name</span>
              <input
                type="text"
                name="name"
                value="<%= h course["name"] %>"
                maxlength="80"
                required
              >
            </label>

            <div class="coursework-row-actions">
              <button type="submit">Save</button>
              <button
                class="danger-button"
                type="submit"
                name="action"
                value="delete_course"
              >
                Remove
              </button>
            </div>
          </form>
        <% end %>
      </div>

      <form class="coursework-create-form" method="post" action="/settings/classes">
        <input type="hidden" name="action" value="create_course">

        <label class="coursework-name-field">
          <span>New class</span>
          <input
            type="text"
            name="name"
            maxlength="80"
            placeholder="Class name"
            required
          >
        </label>

        <button type="submit">+ Add Class</button>
      </form>
    </section>
  </main>
</body>
</html>